# Copy this file to .env.local and fill in real values. Never commit .env.local.
# None of these may start with NEXT_PUBLIC_ — they must never reach the browser.

# Supabase project (region: South Asia / Mumbai)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Long random string used to sign the join cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me

# Shared secret Vercel Cron sends to /api/keepalive.
CRON_SECRET=replace-me
